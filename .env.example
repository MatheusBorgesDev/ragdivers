# Copie para .env.local (ignorado pelo git). Aqui só ficam nomes e valores locais, nenhum segredo.

# Banco. Local: o Supabase local (pnpm db:start), nas portas 553xx para não colidir com outro projeto.
# Produção: o pooler do Supabase em modo transaction (porta 6543), cadastrado no painel da Vercel.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:55322/postgres

# Contato enviado à API da comunidade (cabeçalho X-Super-Contact): a URL do repositório no GitHub, nunca um e-mail.
COMMUNITY_API_CONTACT=https://github.com/OWNER/ragdivers

# Fase 1. A chave da API da Anthropic: você digita aqui e no painel da Vercel. Ela nunca passa pela conversa.
ANTHROPIC_API_KEY=

# Fase 1. Segredo do cron diário que apaga o texto das conversas com mais de 30 dias.
# Local: qualquer texto com 16 ou mais caracteres. Produção: gerado com `openssl rand -base64 32`, no painel da Vercel.
CRON_SECRET=local-only-cron-secret
